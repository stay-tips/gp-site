{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>\n" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{ range .Pages }}
  {{ if and (in (slice "home" "page") .Kind) (not .Params.noindex) }}
  <url><loc>{{ .Permalink }}</loc></url>
  {{ end }}
  {{ end }}
</urlset>
